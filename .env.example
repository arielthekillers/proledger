# ========================================================
# PROLEDGER PRODUCTION ENVIRONMENT CONFIGURATION
# Salin konfigurasi ini ke tab Environment Variables di Coolify
# ========================================================

APP_NAME=ProLedger
APP_ENV=production
APP_DEBUG=false
APP_URL=https://proledger.domainanda.com

# Database Configuration
# Sesuaikan DB_HOST dengan nama service / IP database di Coolify
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=proledger
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=120
